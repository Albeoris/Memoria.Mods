{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memoria official language catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceId",
    "revision",
    "publishedAt",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "official-v1.schema.json#/$defs/schemaVersion"
    },
    "sourceId": {
      "$ref": "official-v1.schema.json#/$defs/sourceId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "official-v1.schema.json#/$defs/component",
        "required": [
          "languageOffers"
        ],
        "properties": {
          "groupId": {
            "const": "Memoria"
          },
          "defaultEnabled": {
            "const": false
          },
          "languageOffers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/offer"
            }
          },
          "dependencies": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/pin"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "official-v1.schema.json#/$defs/component",
        "required": [
          "nativeVariants"
        ],
        "not": {
          "required": [
            "languageOffers"
          ]
        },
        "properties": {
          "groupId": {
            "const": "Memoria"
          },
          "defaultEnabled": {
            "const": false
          },
          "nativeVariants": {
            "$ref": "#/$defs/variants"
          },
          "dependencies": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/pin"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "label",
        "option",
        "nativeVariants"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^(?!jp(?:-|$))[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-[a-z0-9]{5,8}|-[0-9][a-z0-9]{3})*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "option": {
          "type": "string",
          "minLength": 1
        },
        "nativeVariants": {
          "$ref": "#/$defs/variants"
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edition",
          "language"
        ],
        "properties": {
          "edition": {
            "enum": [
              "Classic",
              "Remastered"
            ]
          },
          "language": {
            "type": "string",
            "pattern": "^(?!jp$)[a-z]{2}$"
          }
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "official-v1.schema.json#/$defs/componentId"
        },
        "version": {
          "$ref": "official-v1.schema.json#/$defs/version"
        }
      }
    }
  }
}
