      "$en_glmall2_0044": {
        "Target": "{X60Y10}«Люди идут за силой, а не за обаянием.{Line}А волшебница Эдея и сильна,{Line}и притягательна».{End}",
        "Source Text SHA256": "71AA8F7CCF668B70CBF5BA5B6AC7F149567F0962799C51ED2F21D70FBB762BCD",
        "sourceContext": {
          "Source MSD SHA256": "CA4D420FE3A504FEE88527ED5C92261C1D91388ACD5F6217726D74B7BED82302",
