        }
      },
      "$en_gfvill21_0004": {
        "Target": "{X10Y12}{Char Kiros}{Line}«О какой{Line} работе шла речь?»{End}",
        "Source Text SHA256": "05523AE283B89F0F55D70A368F196EAA1231848AAC0F14394005ABFE55945A29",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0005": {
        "Target": "{X160Y12}{Char Laguna}{Line}«Дело вот в чём.{Line} Всех работоспособных мужчин отправили на войну.{Next}Остались только женщины,{Line} старики, дети, собаки, кошки{Line} да чокобо».{End}",
        "Source Text SHA256": "4ED20322F78E5A39E4B324383998D165B16B1227D718602A536EAB9A1D635E07",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0006": {
        "Target": "{X160Y12}{Char Laguna}{Line}«Как ты наверняка заметил,{Line} монстры уже пробрались в город».{End}",
        "Source Text SHA256": "68F93FF321226DCA2C5F230991608BF022D6C2C8E7CB22F0B3C80681ECD9DE88",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0007": {
        "Target": "{X160Y12}{Char Laguna}{Line}«Я благодарен местным жителям.{Line} Они заботились обо мне».{End}",
        "Source Text SHA256": "404BF20FA414C36A236A1B8AF13A4246EF5DC39D9C6ED1A63A34069749F858FC",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0008": {
        "Target": "{X160Y12}{Char Laguna}{Line}«Поэтому мне хочется как-нибудь их отблагодарить».{End}",
        "Source Text SHA256": "F98D5884231EF1F69EDCCC7926BAEFF9923D8E7568DE0871F6A5D948394473B3",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0009": {
        "Target": "{X160Y12}{Char Laguna}{Line}«Так что перед тобой –{Line} первый и единственный „Винхилльский охотник на монстров“!»{End}",
        "Source Text SHA256": "4CFE4E1C9BD50D2515C0A04C72F5AA2427C08AE76EEE0D999731DC0E4D2DBEE2",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0010": {
        "Target": "{X160Y12}{Char Laguna}{Line}«А с сегодняшнего{Line} дня ты будешь моим помощником».{End}",
        "Source Text SHA256": "DC93C9FA4187DDBE64B0F62723DB023A18727D311BE1E8320862F115B9123ABD",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0011": {
        "Target": "{X160Y12}{Char Laguna}{Line}«Мы должны обойти{Line} весь город.{Next}Если кому-то нужна помощь – помогаем.{Line} Видим монстров – истребляем».{End}",
        "Source Text SHA256": "8950B2ED05EAACCDBF3C30A10ED7CA6C8BA1B1CE154966A443BFF206D2FBD4EE",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0012": {
        "Target": "{X10Y12}«Я смотрю, ты уже{Line} поправился. Может, пора{Line} вернуться в армию?»{End}",
        "Source Text SHA256": "02F142639B7D1EDEBF9809B8D01B3B9DD400212E0DC68E42F0B85DD22636C8FD",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0013": {
        "Target": "{X160Y12}{Char Laguna}{Line}«Ну же, ребята, вы ведь{Line} тоже можете завалить парочку монстров...»{End}",
        "Source Text SHA256": "2100F29F2751B7423872EB43D381F1C19E7AEAD3E9FD00C9DCDE0D46BF356259",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0014": {
        "Target": "{X10Y12}«Ещё чего, мы тут эстарцев высматриваем.{Line} К чёрту монстров».{End}",
        "Source Text SHA256": "82CB929247F3A854ADA51F1F0D6126CECA134D7B679AFC18C62E84E5107CA896",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0015": {
        "Target": "{X160Y12}{Char Laguna}{Line}«Ну вы, парни, даёте...»{End}",
        "Source Text SHA256": "CA6A1C75EB7A80620EB45EE80C18BD3EDA7E272F697ADD27572674FB697A595F",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0016": {
        "Target": "{X10Y12}«Думаешь, солдаты Эстара и{Line} правда идут сюда?»{End}",
        "Source Text SHA256": "04540D962D7BD396496D695E9EC48B89EB3D95F3D4083D187B0BE8A68F946627",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0017": {
        "Target": "{X160Y12}{Char Laguna}{Line}«Прошло уже два года. Думаю, за{Line} это время они бы уже сюда добрались».{End}",
        "Source Text SHA256": "97EC9B45B5A8AF2531B7ED1DC01BE31DDA87DBA4608A622E6D8E2D380C1800E5",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0018": {
        "Target": "{X10Y12}«С{Line} другой стороны, чёрт его знает, что могло взбрести{Line} в голову людям, которыми управляет волшебница…»{End}",
        "Source Text SHA256": "377168E4966853D0ED5C234A3B72CAC12E07A44561A8AF546111B84A1FD9E29F",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0019": {
        "Target": "{X10Y12}«Я пробыл здесь два года.{Line} И мне, чёрт побери, скучно!»{End}",
        "Source Text SHA256": "2BB1B0BC27F2D10A0309FA8310AE38A424703D6A628ED87473BCCA38189642D1",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0020": {
        "Target": "{X160Y12}{Char Laguna}{Line}«Зато, в отличие{Line} от эстарцев, тебе не{Line} нужно похищать маленьких девочек».{End}",
        "Source Text SHA256": "92A04CEADB0C6FAEB39D051ED1D6A42BC8693DD0B44323B26848DF61D02D6D23",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0021": {
        "Target": "{X10Y12}«Наверняка тут замешана Адель…{Line} Чёртова ведьма!{Next}Если они сюда и заявятся, то{Line} только за Эллоной!»{End}",
        "Source Text SHA256": "D1F04F91748421E15AB3364581EBDFD1E3182C3CE591238C47BBBF8771719F4B",
        "sourceContext": {
          "Source MSD SHA256": "2F930D52EF09FB07983F3BC51A2C7C2DD4B5FC4EE11816C5FEB8037B7FCBAD9E",
          "JSM SHA256": "591EF44617A1198C98AB56E8904156C161E2D2BE9676FE98EE94583CE6991722"
        }
      },
      "$en_gfvill21_0022": {
        "Target": "{X160Y12}{Char Laguna}{Line}«Ха!{Line} Они получат её только через мой труп!»{End}",
        "Source Text SHA256": "7E7F35C0B9BD5DA94880CDCA59D68BA89816AB699D1D186DACC983C4554D7031",
