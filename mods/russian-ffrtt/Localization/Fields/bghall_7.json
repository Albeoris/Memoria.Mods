      "$en_bghall_7_0001": {
        "Target": "{X8Y80}{Char Squall}{Line}“Так...”",
        "Source Text SHA256": "7320362AD1738CCC1CBA94E367B44F28DDCDDF79A00A40C4A4ABAF2EB0634A84",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0002": {
        "Target": "{X8Y74}{Char Squall}{Line}“Наш сад действительно очень большой.{Line} Но ты всегда можешь воспользоваться{Line} этой панелью, чтобы добраться до любого{Line} места.”",
