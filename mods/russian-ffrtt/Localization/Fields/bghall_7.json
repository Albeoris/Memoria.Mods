        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0003": {
        "Target": "{X300Y98}“У меня вопрос!”{Next}“Как этой штукой пользоваться?”",
        "Source Text SHA256": "9A9C193784BAAF7E4FC2291F8211D6DE911A0B9210370C4A2FD98D1C55C96FF4",
