          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0004": {
        "Target": "{X65Y200}{Char Squall}{Line}Перемещаем указатель и нажимаем [Крест]{Line}{Key Confirm} для выбора.{End}",
        "Source Text SHA256": "CD9F98CDF385A52D5161A276AD019AFA26CE564F18339883E305C14F2FD9AF71",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0005": {
        "Target": "{X8Y80}{Char Squall}{Line}“Теперь, я рассказываю где-что находится,{Line} а ты слушаешь и запоминаешь.”",
        "Source Text SHA256": "BEBD41486EFF96D3989D4BA5415602D1C16C6C1F197E315513C92A5F3FABF29D",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0006": {
        "Target": "{X300Y92}“Есть, сэр!”",
        "Source Text SHA256": "1349ABB8E2613F0B9E9DC34D6F107C6B39955D93A755CCDE9E11A921CB499CD4",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0007": {
        "Target": "{X65Y86}{Char Squall}{Line}“На севере расположено общежите.”{Next}“Там живут практически{Line} все студенты.”{Next}“Очень редко кто-то{Line} из них ездит домой.”",
        "Source Text SHA256": "6499427B5FEF30017E0C679A25FD05B86795FED4F2533BEEC0E8159C2FBD0E18",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0008": {
        "Target": "{X300Y86}“Ага, я тоже живу в общаге!”",
        "Source Text SHA256": "D3C39ECAFBD2120EB3C2CDC49CCBCC0D5B5ED351CCED9DBD3D144A8D9C957994",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0009": {
        "Target": "{X94Y80}{Char Squall}{Line}“Думаю, понятно, что там ты{Line} можешь отдохнуть и переодеться.”",
        "Source Text SHA256": "58077839594C91BE629C6ACC7D76E27359BEF85C9117B04460D54B9D801FCD1D",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0010": {
        "Target": "{X100Y80}{Char Squall}{Line}“На северо-западе{Line} расположен кафетерий.”",
        "Source Text SHA256": "2C3D1AFA0F1B35E5EE63EFE2DFBF18989F125C4DF434CFC6DB7D602657D4C968",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0011": {
        "Target": "{X100Y80}{Char Squall}{Line}“С тех пор, как в меню появились новые булочки,{Line} там постоянно полно народа. Если хочешь{Line} спокойно поесть, лучше приходи пораньше.”",
        "Source Text SHA256": "0FA276046484593DF84E7DF3C56BF201D317DACEC90C9B106C2309D7542ED42D",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0012": {
        "Target": "{X300Y112}“Всё ясно!”",
        "Source Text SHA256": "08C61375845F02BEFBD9625FAC97864510BD77DF380725948072815C610E7604",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0013": {
        "Target": "{X8Y80}{Char Squall}{Line}“На северо-востоке{Line} находится автостоянка.”",
        "Source Text SHA256": "EBA0CCA27A69DC03ED5915B5109B27CD5DDDBD8B5B4E72E103329EB58A312729",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0014": {
        "Target": "{X8Y74}{Char Squall}{Line}“Обычно, сад предоставляет{Line} машины отправляющимся на{Line} задания группам.”",
        "Source Text SHA256": "6E0C29EFC081D50CFB802BCB5F33A2AF58623BB0A94EAB40797FE631780148BE",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0015": {
        "Target": "{X8Y112}{Char Squall}{Line}“На юге расположены главные ворота...”",
        "Source Text SHA256": "09162B800FB27116A95D2E775BCF7C91FDD43497EB28D4F6C8172337E403F045",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0016": {
        "Target": "{X8Y112}(Чёрт, меня же инструктор ждёт...)",
        "Source Text SHA256": "BDE55B862AED32AFA71FBB06D8DA197A4619AEDDE90DDFCB6389E51564D63B05",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0017": {
        "Target": "{X160Y125}“Что-то случилось?..”",
        "Source Text SHA256": "F6E57F4A879E18247A84B79199670E1CCE6E50860E206BB83F1B13059E2BA2FD",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0018": {
        "Target": "{X30Y112}{Char Squall}{Line}“Нет... ничего.”",
        "Source Text SHA256": "DD84F0502CE7DF558314AC1D3A37E77FE19D5FB25CE8BAF89C9F46CABF93A954",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0019": {
        "Target": "{X100Y86}{Char Squall}{Line}“Продолжим. Площадь на западе.{Line} Там планируется проведение...”",
        "Source Text SHA256": "A294913FFDA96244004F8AE757FB8703B2DD156417875ED621606538D44FDBBB",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
      "$en_bghall_7_0020": {
        "Target": "{X300Y92}“Знаю! Знаю!{Line} Садовый фестиваль!”{Next}“Это будет офигенно!{Line} Я обязательно буду участвовать!”{Next}“А ты?{Line} Не хочешь помочь?”",
        "Source Text SHA256": "43F0E5607FD9B58C1DD8CCEA7CC7346CA3EEF6267C3873175AC526DDF1D77011",
        "sourceContext": {
          "Source MSD SHA256": "27432328F1DB989C60841DBA63E87E29712B01F1C3D466B2BB067746116917BE",
          "JSM SHA256": "9DD00384198224F7FF1825FCB22E7D0E3AD230F08F163A84CE722AEE406763E3"
        }
      },
