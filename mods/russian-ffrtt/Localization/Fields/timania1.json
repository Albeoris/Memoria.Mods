        }
      },
      "$en_timania1_0002": {
        "Target": "{X12Y12}(Здесь полно старых журналов. Эй,{Line} а вот эти из «боевой серии».{Line} Я прочёл все.){End}",
        "Source Text SHA256": "BEB7074D60CE2E697FE29FDB08BD07FB02E1CCB88F75E6B4EB74BB811C2E0D3F",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0003": {
        "Target": "{X160Y120}«Что? Говоришь, я похож на актёра?{Line} Собственно говоря, так и есть».{End}",
        "Source Text SHA256": "48F134BC7BC82C7CF38251DA404B3F004C0BE0A795AE3A65B77B300F99F49213",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0004": {
        "Target": "{X12Y100}(Я ничего не говорил...){End}",
        "Source Text SHA256": "8586D10BD63F5F056529405F9D2C5159E1D3EB61FB191211AF7C94FDB2F33C6F",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0005": {
        "Target": "{X160Y120}«Её полностью{Line} распродали, и{Line} у нас{Line} ничего не осталось{Line} в запасе».{End}",
        "Source Text SHA256": "D50C7515C600796BACD0465DBAA44C2642CD413111FBCC82FA7A522D5C5AB48C",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0006": {
        "Target": "{X160Y120}«В Тимбере много чего происходит,{Line} но искусство раскупается на ура».{End}",
        "Source Text SHA256": "B7E8B0EC44054C852BCC3AD33CB82FEA36E9317A9668101888F651545CDA558B",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0007": {
        "Target": "{X160Y120}«Эй, Я слышал, что карточные игры становятся всё{Line} популярней. Может быть, коллекции фотографий с изображением карт{Line} можно будет неплохо продать».{End}",
        "Source Text SHA256": "63FCC29DE750BF6EB73C173872CE7E3415DDF897B3E207DAC9219889D7279111",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0008": {
        "Target": "{X160Y120}«Или вот что: сборник{Line}о волшебницах. Как думаешь, будут брать?»{End}",
        "Source Text SHA256": "00D13A820138230F6C85FEFE17279F7CCA07335CE778BCE14DE8699C28304084",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0009": {
        "Target": "«Ты занят?{Line} Я занят.{Line} Вот тебе совет».{Next}«Никогда не заговаривай{Line} с редактором, когда он занят.{Line} Уж поверь».{End}",
        "Source Text SHA256": "BE645CF63742959BB9DF4B4397D0FD2FA9F3863F8DC7AA9F936BE513EFED07D8",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0010": {
        "Target": "«В нашем деле главное — продажи.{Line} Продаётся — значит, успех. Редактор{Line} никак не хочет с этим смириться».{End}",
        "Source Text SHA256": "554D369A4C808E5D77FCA9F4CE982791FE84C80B41A47C1A1CBA70384D70911D",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0011": {
        "Target": "«Пока в этом мире идут войны,{Line} боевые журналы вроде „Оружия ежемесячно“{Line} всегда будут пользоваться спросом».{End}",
        "Source Text SHA256": "C3B902469E2F292762D87AD9C200E5B5270DA2DC25C95B746A7CF0518FE22B9A",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0012": {
        "Target": "«(В Тимбере много людей{Line} в сопротивлении, так что было бы{Line} здорово выпустить целую серию{Line} журналов и книг о сражениях.)»{End}",
        "Source Text SHA256": "5CF44F583344811E10AEA4B88FAB0668FD6ADCFCE50FBB9F2BA16E86A72A7344",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0013": {
        "Target": "«Ты, случаем, не хочешь стать журналистом?{Line} Если да, то в этой компании{Line} у тебя вряд ли что-то выйдет.{Line} По-моему, эта профессия уже в прошлом».{End}",
        "Source Text SHA256": "318EE3CD0011E7194B43ADE1D3FE089BFF1542B9C857509E4CDE51C01F5C9ABD",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0014": {
        "Target": "«Слышал, появилась колдунья...{Line} (Самое время заняться торговлей.)»{End}",
        "Source Text SHA256": "46CF6E49488F2D0873F17E951D56E72589C655BADF93360CA0A773BEBFEAC29E",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0015": {
        "Target": "{X12Y12}«Чёрт.{Line} Ну почему книги из боевой серии так хорошо{Line} продаются? Мы определённо живём в ужасное время».{End}",
        "Source Text SHA256": "65AE24128AF074588989D09E11F8C060B839BD0BE5F8A59816C1CF06E583C581",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0016": {
        "Target": "{X12Y12F2L5B2C1}«Ох. Вы осматриваетесь?{Line} Хотите что-нибудь узнать?»{Line}(О Маньяках Тимбера){Line}(Поговорить о сне с Лагуной){Line}(О ситуации в Тимбере){Line}(Ничего особенного){End}",
        "Source Text SHA256": "90A8D955253790F0CFA4E26638DD5346D152F26DE541A7D405F029A171DB666A",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0017": {
        "Target": "{X12Y100}{Char Squall}{Line}«Нет. Спасибо».{End}",
        "Source Text SHA256": "D980EBC4233AB5062CF80F07535224B82F299FFFF0F9B10BF84E18CEDE288173",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0018": {
        "Target": "{X12Y12}«Очень жаль.{Line} Мне нравится болтать с молодыми людьми».{End}",
        "Source Text SHA256": "F810EBF6A825B32E982644A592F0AE106D6BC1CCFA15BC9B9969168D9AD17173",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0019": {
        "Target": "{X12Y12}«Хорошо. Ну, как вам{Line} уже известно, компания называется Маньяки Тимбера.{Next}Мы - издательство,{Line} основанное 20 лет тому назад.{Next}Раньше мы публиковали журнал под{Line} названием Мани Тим, сокращенно от Маньяки Тимбера.{Next}Это была подборка{Line} внештатных документов: писем, докладов, и т. д...{Next}Большинство фанатов хотели{Line} стать журналистами.{Next}Я присоединился к компании, потому что хотел{Line} стать редактором для Мани Тим».{End}",
        "Source Text SHA256": "D679B2BD2FD713982A24723B59B1A1A836F70F8FEAD215BF4C8AA5D390770F46",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0020": {
        "Target": "{X12Y100}{Char Squall}{Line}«Недавно мне снился{Line} странный сон, будто я стал гальбадианским{Line} солдатом по{Line} имени Лагуна».{End}",
        "Source Text SHA256": "85A503CC50D1C5196AD7FC07B88E09193AA727348894E6E427305A4A9445D0C7",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0021": {
        "Target": "{X12Y12}«Да. Сны бывают весьма странными. Вот{Line} сегодня утром мне снилось, что...»{End}",
        "Source Text SHA256": "8C5130B683CAA668FAEE4A1B0D0F76E2643EFB3AACCE073D48663157400F7CBC",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0022": {
        "Target": "{X12Y12}«Мне всё равно, что происходит в{Line} Тимбере на сегодняшний день. Вот знаете, в{Line} моём детстве всё было совсем не так.{Next}Тогда мы были{Line} в самом разгаре войны против волшебницы. Поэтому{Line} я писал письма Маньякам Тимбера, подчёркивая, какой{Line} бессмысленной была война.{Next}Я был по-настоящему счастлив, несмотря на то, что{Line} шла война. Это дало мне надежду на{Line} будущее».{End}",
        "Source Text SHA256": "34BB65FE1747B0CBE953E108999E2E45E1008B17482EED3AD535E73C88550F3A",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0023": {
        "Target": "«Вот раньше было весело.{Line} У нас не было всех{Line} нынешних вещей...»{Next}«Но мы находили себе занятие:{Line} мастерили игрушки и всё такое».{Next}«А нынешние дети и молодёжь,{Line} скажу я вам, избалованные эгоисты...»{End}",
        "Source Text SHA256": "8BA8050563F03DFD5D95E44FB04C8A53AFAF1E465B3CE52F31585C30A7CDF2F8",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0024": {
        "Target": "(...Как же скучно.){End}",
        "Source Text SHA256": "7C9E7C896145E7F967C73CA3B6705736A7E806ACE1A60F20A255550B7C93CF0F",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0025": {
        "Target": "(Очередная дурацкая история скучного взрослого.){End}",
        "Source Text SHA256": "5D22F8DCC722DE4954FA2B265F2D4AA384F1946D9EF8019C29FE843368EBC085",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      },
      "$en_timania1_0026": {
        "Target": "(Ему нужно жить настоящим.){End}",
        "Source Text SHA256": "FADF28CB86B41A4EAB0E157962DDD79D41B04236B694347AE46CBCB88A87369C",
        "sourceContext": {
          "Source MSD SHA256": "77747FA52D256DB465746729D221A17B393038587CA4B0C9CE4B20548C2BF8D7",
          "JSM SHA256": "4F9BE67697B1948A4F2AE1FC422C8BB6BB456BD9A4D31A4E2BB987661BF1CFC0"
        }
      }
    }
