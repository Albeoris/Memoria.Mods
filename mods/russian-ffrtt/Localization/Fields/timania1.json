      "$en_timania1_0001": {
        "Target": "{X12Y100}Найден старый выпуск [Маньяков Тимбера]!{Line}{Pause 48}... {Pause 48}... {Pause 48}... {Pause 48}...... Выпуск прочитан!{End}",
